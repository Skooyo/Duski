{
  "name": "duski",
  "version": "0.1.1",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "check": "node --no-warnings src/shared/todo.check.mts",
    "start": "node build.mjs && electron .",
    "dist": "node build.mjs && electron-builder --win nsis --publish never",
    "deploy": "node deploy.mjs",
    "release": "npm version patch --no-git-tag-version && node build.mjs && electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "dompurify": "^3.4.16",
    "electron-updater": "^6.8.9",
    "marked": "^18.0.14"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "description": "Radial pie menu overlay with Claude chat and translation",
  "author": "Duski",
  "build": {
    "appId": "com.duski.app",
    "productName": "Duski",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "static/**/*",
      "resources/duski-icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/duski-icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Duski",
      "artifactName": "Duski-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "Skooyo",
      "repo": "Duski",
      "releaseType": "release"
    }
  }
}
